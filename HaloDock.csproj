<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>HaloDock</RootNamespace>
    <AssemblyName>HaloDock</AssemblyName>
    <Version>0.4.0</Version>
    <Product>HaloDock</Product>
    <Description>Radial launcher that pops out from the edge of your screen.</Description>
    <!-- WinForms is only used for the tray icon; DPI awareness belongs in the manifest for WPF. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

</Project>
