<Window x:Class="HaloDock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HaloDock Settings" Width="720" Height="600" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterScreen" ThemeMode="System">
  <Window.Resources>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,12"/>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="Width" Value="70"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="DockPanel.Dock" Value="Right"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Save" IsDefault="True" Click="Save_Click" Margin="0,0,8,0" MinWidth="120"
              Style="{DynamicResource AccentButtonStyle}"/>
      <Button Content="Cancel" IsCancel="True" MinWidth="120"/>
    </StackPanel>

    <TabControl Padding="12">
      <TabItem Header="Items">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Delete ring" Click="DeleteRing_Click" Margin="8,0,0,0" MinWidth="110"/>
              <Button DockPanel.Dock="Right" Content="New ring" Click="NewRing_Click" Margin="8,0,0,0" MinWidth="110"/>
              <ComboBox x:Name="RingPicker" SelectionChanged="RingPicker_SelectionChanged">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="12" Height="12" Fill="{Binding Brush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </DockPanel>
            <DockPanel Margin="0,10,0,0">
              <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBox x:Name="RingName" Width="200" VerticalAlignment="Center"
                       Text="{Binding SelectedItem.Name, ElementName=RingPicker, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Text="Colour" VerticalAlignment="Center" Margin="20,0,10,0"/>
              <ItemsControl x:Name="Swatches" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Width="26" Height="26" Margin="0,0,4,0" Cursor="Hand" Background="Transparent"
                          MouseLeftButtonUp="Swatch_Click" ToolTip="{Binding Color}">
                      <Ellipse Width="24" Height="24" Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                               StrokeThickness="2" Visibility="{Binding SelectedVisibility}"/>
                      <Ellipse Width="16" Height="16" Fill="{Binding Brush}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                       Text="Each ring is its own set of items. In the menu, click a coloured dot on the inner ring to switch, or scroll just inside the icons. Drag things in from Explorer, and click an item's name to rename it. You can also hold an icon in the menu to move it, or drag files into the menu to add them."/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" Width="130">
            <Button Content="Add files…" Click="AddFiles_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
            <Button Content="Add folder…" Click="AddFolder_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
            <Button Content="Remove" Click="Remove_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
            <Button Content="Move up" Click="MoveUp_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
            <Button Content="Move down" Click="MoveDown_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
          </StackPanel>
          <ListBox x:Name="ItemsList" AllowDrop="True" Drop="ItemsList_Drop" DragOver="ItemsList_DragOver"
                   HorizontalContentAlignment="Stretch" SelectionMode="Extended"
                   PreviewGotKeyboardFocus="ItemsList_PreviewGotKeyboardFocus">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="2,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                  <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0"
                             Background="Transparent" FontWeight="SemiBold" Padding="0"/>
                    <TextBlock Text="{Binding Path}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Not found" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="11" Visibility="{Binding MissingVisibility}"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

      <TabItem Header="Monitors">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Choose which displays open the menu when the pointer rests against their left edge."/>
            <RadioButton x:Name="ModeAll" GroupName="Mode" Content="All monitors" Margin="0,4" Checked="Mode_Checked"/>
            <RadioButton x:Name="ModePrimary" GroupName="Mode" Content="Primary monitor only" Margin="0,4" Checked="Mode_Checked"/>
            <RadioButton x:Name="ModeSelected" GroupName="Mode" Content="Only these monitors:" Margin="0,4" Checked="Mode_Checked"/>
            <ItemsControl x:Name="MonitorList" Margin="24,4,0,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,3"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <CheckBox x:Name="OuterOnly" Content="Only use outer edges" Margin="0,12,0,0"/>
            <TextBlock Style="{StaticResource Hint}" Margin="24,2,0,0"
                       Text="Skips a left edge that borders another monitor, so moving the pointer between screens never opens the menu. Turn this off to also open it by pausing on the seam between two screens."/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Behavior">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="Hover delay"/>
            <DockPanel>
              <TextBlock Style="{StaticResource Value}" Text="{Binding Value, ElementName=DelaySlider, StringFormat={}{0:0} ms}"/>
              <Slider x:Name="DelaySlider" Minimum="0" Maximum="1000" TickFrequency="25" IsSnapToTickEnabled="True"/>
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}" Text="How long the pointer must rest on the edge before the menu opens."/>

            <TextBlock Style="{StaticResource Heading}" Text="Edge thickness"/>
            <DockPanel>
              <TextBlock Style="{StaticResource Value}" Text="{Binding Value, ElementName=EdgeSlider, StringFormat={}{0:0} px}"/>
              <Slider x:Name="EdgeSlider" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"/>
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}" Text="How close to the edge counts as touching it."/>

            <TextBlock Style="{StaticResource Heading}" Text="Wheel radius"/>
            <DockPanel>
              <TextBlock Style="{StaticResource Value}" Text="{Binding Value, ElementName=RadiusSlider, StringFormat={}{0:0}}"/>
              <Slider x:Name="RadiusSlider" Minimum="120" Maximum="360" TickFrequency="10" IsSnapToTickEnabled="True"/>
            </DockPanel>

            <TextBlock Style="{StaticResource Heading}" Text="Item size"/>
            <DockPanel>
              <TextBlock Style="{StaticResource Value}" Text="{Binding Value, ElementName=SizeSlider, StringFormat={}{0:0}}"/>
              <Slider x:Name="SizeSlider" Minimum="40" Maximum="128" TickFrequency="4" IsSnapToTickEnabled="True"/>
            </DockPanel>

            <TextBlock Style="{StaticResource Heading}" Text="Remove-from-ring symbol"/>
            <ComboBox x:Name="SymbolPicker" HorizontalAlignment="Left" MinWidth="220">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               Width="28" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Appears in the middle of the menu while you hold an icon. Dropping the icon there takes it off the ring; the file itself is never touched."/>

            <CheckBox x:Name="InvertScroll" Content="Reverse scroll direction" Margin="0,18,0,6"/>
            <CheckBox x:Name="IgnoreFullscreen" Content="Don't open over full-screen apps and games" Margin="0,6"/>
            <CheckBox x:Name="StartWithWindows" Content="Start HaloDock when I sign in to Windows" Margin="0,6"/>

            <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0"
                       Text="In the menu: scroll to turn the wheel, left-click to open, right-click for the usual Windows menu. Drag files to the edge and drop them on a folder to move/copy them there (Ctrl = copy, Shift = move), or on an app to open them with it. Move away to close."/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
